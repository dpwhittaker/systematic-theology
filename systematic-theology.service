[Unit]
Description=Systematic Theology — static site (served at /theology/ via claude-hub)
After=network.target

[Service]
Type=simple
User=david
WorkingDirectory=/home/david/projects/systematic-theology
ExecStart=/usr/bin/python3 -m http.server 8000 --bind 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
